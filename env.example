# ==============================================
# BETTING PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================
# Copy this file to .env and update with your actual values
# NEVER commit .env files to version control!

# ----------------------------------------------
# DATABASE CONFIGURATION (PostgreSQL - Current)
# NOTE: Will migrate to SQLite in Phase 2
# ----------------------------------------------
DATABASE_URL=postgresql://admin:admin123@localhost:5432/betting_platform
DB_HOST=localhost
DB_PORT=5432
DB_NAME=betting_platform
DB_USER=admin
DB_PASSWORD=admin123

# ----------------------------------------------
# APPLICATION CONFIGURATION
# ----------------------------------------------
NODE_ENV=development
PORT=3000

# Admin Portal URLs
VITE_API_URL=http://localhost:3001/api

# User Portal URL
VITE_USER_APP_URL=http://localhost:3002

# ----------------------------------------------
# JWT AUTHENTICATION
# ----------------------------------------------
# Generate a strong secret key for production!
# Use: openssl rand -base64 64
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=7d

# ----------------------------------------------
# SECURITY CONFIGURATION
# ----------------------------------------------
# Password hashing rounds (10-12 recommended)
BCRYPT_ROUNDS=12

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ----------------------------------------------
# OPTIONAL SERVICES (Not currently used)
# ----------------------------------------------
# Supabase (if implementing)
# SUPABASE_URL=your_supabase_url_here
# SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Email notifications (if implementing)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password

# Redis cache (if implementing)
# REDIS_URL=redis://localhost:6379

# File uploads (if implementing)
# UPLOAD_MAX_SIZE=10485760
# UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,application/pdf
