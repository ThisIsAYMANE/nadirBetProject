# ==============================================
# BACKEND SERVER - ENVIRONMENT CONFIGURATION
# ==============================================
# Copy this file to 'env' (no .env extension) and update with your actual values
# NEVER commit actual 'env' files to version control!

# ----------------------------------------------
# DATABASE CONFIGURATION (PostgreSQL - Current)
# NOTE: Will migrate to SQLite in Phase 2
# ----------------------------------------------
DATABASE_URL=postgresql://admin:admin123@localhost:5432/betting_platform
DB_HOST=localhost
DB_PORT=5432
DB_NAME=betting_platform
DB_USER=admin
DB_PASSWORD=admin123

# ----------------------------------------------
# SERVER CONFIGURATION
# ----------------------------------------------
PORT=3001
NODE_ENV=development

# Frontend URLs for CORS
FRONTEND_URL=http://localhost:5173

# ----------------------------------------------
# JWT AUTHENTICATION
# ----------------------------------------------
# Generate a strong secret key for production!
# Use: openssl rand -base64 64
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# ----------------------------------------------
# SECURITY CONFIGURATION
# ----------------------------------------------
# Password hashing rounds (10-12 recommended)
BCRYPT_ROUNDS=12

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS origins (comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:3002

# ----------------------------------------------
# CASINO API - PRAGMATIC PLAY (Current)
# NOTE: Will migrate to Slotgator in Phase 5
# ----------------------------------------------
# Get credentials from Pragmatic Play dashboard
PRAGMATIC_SECURE_LOGIN=your_secure_login_here
PRAGMATIC_SECRET_KEY=your_secret_key_here
PRAGMATIC_PROVIDER_ID=PragmaticPlay
PRAGMATIC_API_URL=https://api.prerelease-env.biz

# Callback URL for Pragmatic webhooks (use ngrok for local dev)
# Example: https://your-subdomain.ngrok.io/api/pragmatic
PRAGMATIC_CALLBACK_URL=https://your-ngrok-url.ngrok.io/api/pragmatic

# ----------------------------------------------
# SPORTS API (To be implemented in Phase 6)
# ----------------------------------------------
# SPORTS_API_URL=https://api.the-odds-api.com
# SPORTS_API_KEY=your_key_here

# ----------------------------------------------
# SLOTGATOR CASINO API (To be implemented in Phase 5)
# ----------------------------------------------
# SLOTGATOR_API_URL=https://api.slotgator.com
# SLOTGATOR_API_KEY=your_api_key_here
# SLOTGATOR_OPERATOR_ID=your_operator_id
# SLOTGATOR_SECRET_KEY=your_secret_key
# SLOTGATOR_CALLBACK_URL=https://yourdomain.com/api/slotgator/callback
